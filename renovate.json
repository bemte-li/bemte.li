{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":prHourlyLimit2",
    ":prConcurrentLimit10",
    "group:allNonMajor"
  ],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencias"],
  "commitMessagePrefix": "chore(deps):",
  "rangeStrategy": "auto",
  "ignorePaths": [
    "vibe-coding-docs/**",
    "openspec/changes/archive/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend (minor + patch)",
      "automerge": false
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "backend (minor + patch)"
    },
    {
      "matchPackageNames": ["next", "react", "react-dom"],
      "groupName": "next.js core",
      "matchUpdateTypes": ["major", "minor", "patch"]
    },
    {
      "matchPackageNames": ["pocketbase", "github.com/pocketbase/pocketbase"],
      "description": "PocketBase tem mudancas quebradoras frequentes; sempre revisar manualmente",
      "matchUpdateTypes": ["major", "minor"],
      "labels": ["dependencias", "atencao"],
      "automerge": false
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker images",
      "pinDigests": false
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["seguranca"],
    "automerge": false,
    "schedule": ["at any time"]
  }
}
